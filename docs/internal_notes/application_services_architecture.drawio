          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_r2_worker" value="SVG Stream (R2 Origin)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.8;fontSize=10;fontStyle=1;fontColor=#15803D;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="cf_edge_container" source="node_r2" target="node_worker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Link 2: View Headers w/ Auth -> Tunnel Edge Ingress -->
        <mxCell id="edge_worker_tunnel_edge" value="View Headers w/ Auth&#xa;(/secure/headers)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=1.8;fontSize=10;fontStyle=1;fontColor=#1D4ED8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="cf_edge_container" source="node_worker" target="node_tunnel_edge">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Link 3: View Headers w/out Auth -> CDN Cache / Open Endpoint -->
        <mxCell id="edge_worker_noauth" value="View Headers w/out Auth&#xa;(https://tunnel.cambrera.net/)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.8;dashed=1;fontSize=10;fontStyle=1;fontColor=#475569;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="cf_edge_container" source="node_worker" target="node_cdn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ================= AWS ORIGIN COMPONENTS ================= -->
        <!-- AWS Security Group -->
        <mxCell id="node_sg" value="AWS Security Group&#xa;&lt;b&gt;Allow Cloudflare IPs (Port 443)&lt;/b&gt;&#xa;&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;DROP ALL OTHER DIRECT TRAFFIC&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fontColor=#991B1B;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1.5;" vertex="1" parent="aws_origin_container">
          <mxGeometry x="50" y="50" width="310" height="55" as="geometry"/>
        </mxCell>

        <!-- AWS ALB (Public CDN Route) -->
        <mxCell id="node_alb" value="&lt;b&gt;AWS Application Load Balancer (ALB)&lt;/b&gt;&#xa;Origin for www.cambrera.net (HTTPS:443)&#xa;&lt;font color=&quot;#6D28D9&quot;&gt;ACM Cert: www-origin.cambrera.net&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fontColor=#6D28D9;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=1.5;" vertex="1" parent="aws_origin_container">
          <mxGeometry x="50" y="150" width="310" height="60" as="geometry"/>
        </mxCell>

        <!-- cloudflared Daemon (Zero Trust Route) -->
        <mxCell id="node_tunnel_daemon" value="&lt;b&gt;cloudflared Sidecar Daemon&lt;/b&gt;&#xa;Tunnel UUID: bafe27e6-f0e1&#xa;&lt;font color=&quot;#0369A1&quot;&gt;&lt;b&gt;Outbound QUIC (UDP 7844) | Zero Ingress&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fontColor=#0369A1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=1.5;" vertex="1" parent="aws_origin_container">
          <mxGeometry x="50" y="270" width="310" height="65" as="geometry"/>
        </mxCell>

        <!-- HTTP-Echo Container -->
        <mxCell id="node_backend" value="&lt;b&gt;HTTP-Echo App Container&lt;/b&gt;&#xa;Localhost:8080 (Elastic Beanstalk Instance)&#xa;&lt;font color=&quot;#C2410C&quot;&gt;Returns Request Headers JSON&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fontColor=#C2410C;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=1.5;" vertex="1" parent="aws_origin_container">
          <mxGeometry x="50" y="440" width="310" height="65" as="geometry"/>
        </mxCell>

        <!-- AWS Origin Internal Edges -->
        <!-- ALB forwards port 80 to container -->
        <mxCell id="edge_alb_backend" value="Forward HTTP:80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6D28D9;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#6D28D9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="aws_origin_container" source="node_alb" target="node_backend">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="380" y="180"/>
              <mxPoint x="380" y="460"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- cloudflared forwards directly to localhost:8080 (BYPASSING ALB!) -->
        <mxCell id="edge_daemon_backend" value="Forward to localhost:8080 (Bypasses ALB)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#0369A1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="aws_origin_container" source="node_tunnel_daemon" target="node_backend">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ================= CROSS-ZONE / EXTERNAL CONNECTIONS ================= -->
        <!-- User GET / (homepage allowed) -->
        <mxCell id="edge_user_homepage" value="GET / (homepage allowed)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1D4ED8;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="client_user" target="node_dns">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="240"/>
              <mxPoint x="180" y="122"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- User GET /secure* -->
        <mxCell id="edge_user_secure" value="GET /secure*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#B91C1C;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="client_user" target="node_access">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="265"/>
              <mxPoint x="180" y="297"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- CDN Proxy to AWS ALB (Public HTTPS Route) -->
        <mxCell id="edge_cdn_alb" value="Public HTTPS:443 (www.cambrera.net)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;dashed=1;fontSize=10;fontStyle=1;fontColor=#475569;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_cdn" target="node_alb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1060" y="122"/>
              <mxPoint x="1060" y="220"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- PERSISTENT OUTBOUND-ONLY QUIC TUNNEL (Tunnel Edge to AWS cloudflared) -->
        <mxCell id="edge_quic_tunnel" value="PERSISTENT OUTBOUND-ONLY QUIC TUNNEL&#xa;&lt;font size=&quot;1&quot; color=&quot;#0369A1&quot;&gt;UDP 7844 | Zero Inbound Firewall Ports | Origin Cloaked&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=3;dashed=1;dashPattern=6 4;fontSize=11;fontStyle=1;fontColor=#0369A1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_tunnel_edge" target="node_tunnel_daemon">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="800" y="501"/>
              <mxPoint x="800" y="342"/>
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

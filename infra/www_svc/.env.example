# Cloudflare credentials for the www_svc stack (infra/www_svc): example file with placeholder values.
#
# The Cloudflare Terraform provider has no credentials file; it reads environment variables. This file is a
# convenient way to set them locally, one per environment, so each environment can use its own token.
#
# 1. Create an API token in the Cloudflare dashboard:
#    My Profile > API Tokens > Create Token > Create Custom Token.
#    Grant the permissions listed in the README (Authentication), scoped to your account and the cambrera.net zone only,
#    so this token can't change other environments.
# 2. Copy this file to .env (gitignored) in this folder (infra/www_svc) and replace the placeholder.
# 3. Restrict permissions: chmod 600 .env
# 4. Load it into your shell before running Terraform (from this folder):
#      set -a; source .env; set +a
#    Variables stay set for the rest of the shell session, so start a new shell (or unset CLOUDFLARE_API_TOKEN)
#    before switching to another environment. Or let a tool load it per folder:
#      direnv:        add "dotenv" to a .envrc in this folder (also gitignored), then: direnv allow
#                     (direnv loads it when you cd in and unloads it when you leave)
#      1Password CLI: store the token in 1Password, set the value below to an op:// reference, then run
#                     op run --env-file=.env -- terraform plan
#
# Never commit a real .env. In CI, set CLOUDFLARE_API_TOKEN as a secret environment variable for the www_svc job instead.

CLOUDFLARE_API_TOKEN=replace-with-your-ci-api-token

# Legacy alternative (not recommended): the Global API Key has full access to your whole account.
# Use it only if a token isn't possible, and don't set CLOUDFLARE_API_TOKEN at the same time.
# CLOUDFLARE_API_KEY=replace-with-your-global-api-key
# CLOUDFLARE_EMAIL=you@example.com
